# === 易支付侧（对 new-api）===
# new-api 后台「支付设置」里的 EpayId/EpayKey 必须与此一致
EPAY_PID=1001
EPAY_KEY=change-me-to-a-long-random-secret

# === 服务 ===
BIND_HOST=0.0.0.0:8787   # 容器内必须 0.0.0.0；宿主侧由 compose ports 限定 127.0.0.1
DB_PATH=/data/orders.db
# 公网基底（微信回调 & 页面跳转依据），如 https://pay.example.com
NOTIFY_BASE=https://pay.example.com
RETURN_PATH=https://<控制台域名>/console/topup


# === 微信支付 Native v3（商户平台 → API 安全 → 拿到以下四样）===
WXPAY_APPID=wx1234567890abcdef
WXPAY_MCH_ID=1900000000
WXPAY_SERIAL_NO=证书序列号（商户平台 API 证书管理页）
WXPAY_PRIVATE_KEY_FILE=/opt/epay-deploy/apiclient_key.pem
# 或单行粘贴（换行写作 \n）：WXPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
WXPAY_APIV3_KEY=32位APIv3密钥
# 仅测试指向 mock 时改
# WXPAY_API_BASE=https://api.mch.weixin.qq.com
